{
    "name": "ui_monaco",
    "parameters": {
        "import_from_scratchpad": {
            "type": "boolean",
            "default": true
        },
        "font_size": {
            "type": "int",
            "default": 14
        },
        "theme": {
            "type": "string",
            "default": ""
        },
        "auto_switch_light_dark": {
            "type": "boolean",
            "default": true
        },
        "minimap": {
            "type": "boolean",
            "default": false
        },
        "word_wrap": {
            "type": "string",
            "default": "off"
        },
        "tab_size": {
            "type": "int",
            "default": 4
        },
        "lsp_enabled": {
            "type": "boolean",
            "default": true
        },
        "lsp_language": {
            "type": "string",
            "default": ""
        },
        "lsp_prefix_code": {
            "type": "string",
            "default": ""
        },
        "lsp_url": {
            "type": "string",
            "default": ""
        },
        "lsp_base_url": {
            "type": "string",
            "default": ""
        },
        "use_simple_lsp": {
            "type": "boolean",
            "default": true
        },
        "semantic_highlighting": {
            "type": "boolean",
            "default": false,
            "label": "Enable semantic highlighting",
            "help": "Enable LSP semantic highlighting (token coloring) when supported. Disabled by default."
        },
        "autosave": {
            "type": "boolean",
            "default": false,
            "label": "Enable autosave to browser storage",
            "help": "If enabled, student code is periodically backed up to browser storage."
        },
        "rich_features": {
            "type": "boolean",
            "default": true
        },
        "disable_lsp_prefixes": {
            "type": "boolean",
            "default": false
        },
        "lsp_workspace_config": {
            "type": "string",
            "default": ""
        }
    }
}
