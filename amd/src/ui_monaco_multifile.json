{
    "name": "ui_monaco_multifile",
    "parameters": {
        "font_size": {
            "type": "int",
            "default": 14
        },
        "theme": {
            "type": "string",
            "default": ""
        },
        "auto_switch_light_dark": {
            "type": "boolean",
            "default": true
        },
        "minimap": {
            "type": "boolean",
            "default": false
        },
        "word_wrap": {
            "type": "string",
            "default": "off"
        },
        "tab_size": {
            "type": "int",
            "default": 4
        },
        "lsp_enabled": {
            "type": "boolean",
            "default": true
        },
        "lsp_prefix_code": {
            "type": "string",
            "default": ""
        },
        "lsp_url": {
            "type": "string",
            "default": ""
        },
        "lsp_base_url": {
            "type": "string",
            "default": ""
        },
        "use_simple_lsp": {
            "type": "boolean",
            "default": true
        },
        "rich_features": {
            "type": "boolean",
            "default": true
        },
        "disable_lsp_prefixes": {
            "type": "boolean",
            "default": false
        },
        "lsp_workspace_config": {
            "type": "string",
            "default": ""
        },
        "sidebar_width": {
            "type": "int",
            "default": 200
        },
        "max_files": {
            "type": "int",
            "default": 20
        },
        "allowed_extensions": {
            "type": "string[]",
            "default": ["html", "css", "js", "json", "txt"]
        },
        "disable_new_files": {
            "type": "boolean",
            "default": false
        },
        "disable_new_folders": {
            "type": "boolean",
            "default": false
        },
        "autosave": {
            "type": "boolean",
            "default": false
        },
        "use_vscode_icons": {
            "type": "boolean",
            "default": true
        },
        "semantic_highlighting": {
            "type": "boolean",
            "default": false
        },
        "sync_interval_secs": {
            "type": "int",
            "default": 5
        }
    }
}
